---
import { getLangFromUrl } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={`/${lang}/`} class="footer-logo">
          <img src="/assets/logo-octo-white.svg" alt="OCTO Technology" width="140" height="28" />
        </a>
        <span class="footer-tagline">{t('footer.tagline')}</span>
      </div>
      <div class="footer-links">
        <a href="https://www.octo.com/mentions-legales" target="_blank" rel="noopener noreferrer">{t('footer.legal')}</a>
        <a href="https://blog.octo.com" target="_blank" rel="noopener noreferrer">{t('footer.blog')}</a>
        <a href="https://www.octo.com/contact" target="_blank" rel="noopener noreferrer">{t('footer.contact')}</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {new Date().getFullYear()} OCTO Technology &mdash; Part of Accenture
      </p>
      <div class="footer-social">
        <a href="https://www.linkedin.com/company/octo-technology" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a href="https://twitter.com/OCTO_Technology" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--octo-main);
    color: var(--octo-white);
    padding-block: var(--space-xl);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .footer-logo {
    display: flex;
    align-items: center;
  }

  .footer-tagline {
    color: var(--octo-secondary);
    font-weight: 600;
    font-style: italic;
  }

  .footer-links {
    display: flex;
    gap: var(--space-lg);
  }

  .footer-links a {
    color: var(--octo-white);
    font-size: 0.85rem;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .footer-links a:hover {
    opacity: 1;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .footer-copyright {
    font-size: 0.8rem;
    opacity: 0.7;
  }

  .footer-social {
    display: flex;
    gap: var(--space-md);
  }

  .footer-social a {
    color: var(--octo-white);
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .footer-social a:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .footer-top,
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-brand {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
